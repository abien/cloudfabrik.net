---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Statusbar from '../components/Statusbar.astro';
import ArchiveList from '../components/ArchiveList.astro';

const allPosts = await getCollection('til', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => 
  b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="Archive" description="Complete archive of all TIL entries">
  <Header currentPath="/archive" />
  
  <main class="flex flex-1 justify-center py-10 px-4 md:px-0 bg-bg-main">
    <div class="flex flex-col w-full max-w-[800px] flex-1">
      <div class="flex flex-wrap justify-between items-end gap-3 p-4 mb-6 border-l-4 border-accent bg-bg-editor/50">
        <div class="flex flex-col gap-1">
          <h1 class="text-text-bright text-3xl font-black tracking-tight font-mono uppercase">Log Archive</h1>
          <p class="text-text-muted text-sm font-mono italic">
            Total entries: {sortedPosts.length} — Press <kbd class="px-1.5 py-0.5 rounded bg-bg-hover text-xs border border-border">Ctrl</kbd> + <kbd class="px-1.5 py-0.5 rounded bg-bg-hover text-xs border border-border">F</kbd> to search.
          </p>
        </div>
      </div>
      
      <ArchiveList entries={sortedPosts} />
    </div>
  </main>
  
  <Statusbar articleCount={sortedPosts.length} />
</BaseLayout>
