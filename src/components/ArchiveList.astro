---
import type { CollectionEntry } from 'astro:content';
import { Terminal, Database, Cpu, Globe, Server, ChevronRight } from '@lucide/astro';
import { formatDate } from '../utils/date';
import type { Category } from '../utils/category';

interface Props {
  entries: CollectionEntry<'til'>[];
}

const { entries } = Astro.props;

const getCategoryIcon = (category: Category) => {
  const icons = {
    'AI/ML': Terminal,
    'DevOps': Database,
    'Systems': Cpu,
    'Web': Globe,
    'Infra': Server,
  };
  return icons[category] || Terminal;
};
---

<div class="flex flex-col border border-border rounded-lg overflow-hidden bg-bg-hover">
  {entries.map((entry) => {
    const IconComponent = getCategoryIcon(entry.data.category);
    return (
      <a 
        href={`/til/${entry.id}`}
        class="group flex items-center gap-4 border-b border-border-dark hover:bg-bg-hover px-4 py-3 transition-colors cursor-pointer last:border-b-0"
      >
        <div class="shrink-0 w-28">
          <p class="text-text-muted text-sm font-mono">{formatDate(entry.data.pubDate)}</p>
        </div>
        <div class="text-accent/70 shrink-0">
          <IconComponent class="w-[18px] h-[18px]" />
        </div>
        <p class="text-text-primary text-base font-mono flex-1 truncate group-hover:text-accent transition-colors">
          {entry.data.title}
        </p>
        <ChevronRight class="w-4 h-4 text-border group-hover:text-accent transition-colors" />
      </a>
    );
  })}
  
  <div class="flex items-center justify-center p-6 bg-bg-editor/30">
    <p class="text-text-muted text-xs font-mono uppercase tracking-widest">
      --- End of List ---
    </p>
  </div>
</div>
