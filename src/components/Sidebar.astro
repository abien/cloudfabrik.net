---
import { Home, Lightbulb, RefreshCw, Archive, Github, Linkedin } from '@lucide/astro';
import EmailLink from './EmailLink.astro';

interface Props {
  currentPage?: 'home' | 'til' | 'updated' | 'archive';
}

const { currentPage = 'home' } = Astro.props;

const navItems = [
  { id: 'home', label: 'Home', icon: Home, href: '/' },
  { id: 'til', label: 'TIL', icon: Lightbulb, href: '/#til' },
  { id: 'updated', label: 'Updated', icon: RefreshCw, href: '/#updated' },
  { id: 'archive', label: 'Archive', icon: Archive, href: '/archive' },
];
---

<aside class="w-16 md:w-64 border-r border-border bg-bg-editor flex flex-col justify-between p-2 md:p-4 shrink-0">
  <div class="flex flex-col gap-4 md:gap-6">
    <div class="hidden md:flex flex-col items-center p-4 rounded-lg bg-bg-hover/50 border border-border">
      <div 
        class="bg-center bg-no-repeat aspect-square bg-cover rounded-full size-16 border-2 border-accent/30 mb-3"
        style="background-image: url('/images/profile.jpg');"
      ></div>
      <div class="flex flex-col items-center">
        <h1 class="text-text-bright text-sm font-bold font-mono">abien</h1>
        <EmailLink 
          email="abien@cloudfabrik.net" 
          class="text-text-muted hover:text-accent text-[10px] font-mono mt-1 transition-colors"
        />
      </div>
    </div>
    
    <nav class="flex flex-col gap-1">
      {navItems.map((item) => (
        <a 
          href={item.href}
          aria-label={item.label}
          class:list={[
            'flex flex-row items-center justify-center md:justify-start gap-0 md:gap-2 px-2 py-3 md:px-3 md:py-2 rounded cursor-pointer transition-colors text-[11px] md:text-xs font-medium font-mono md:whitespace-nowrap',
            currentPage === item.id 
              ? 'bg-accent/20 text-accent border-l-2 border-accent' 
              : 'text-text-muted hover:bg-bg-hover hover:text-text-bright'
          ]}
        >
          <item.icon class="w-5 h-5" />
          <span class="hidden md:inline">{item.label}</span>
        </a>
      ))}
    </nav>
  </div>
  
  <div class="flex flex-col gap-2">
    <a 
      href="https://github.com/abien/" 
      target="_blank" 
      rel="noopener noreferrer"
      aria-label="GitHub"
      class="flex flex-row items-center justify-center md:justify-start gap-0 md:gap-3 px-2 py-2 md:px-3 text-text-muted hover:text-accent transition-colors cursor-pointer"
    >
      <Github class="w-5 h-5" />
      <span class="hidden md:inline text-[11px] font-mono">GitHub</span>
    </a>
    <a 
      href="https://www.linkedin.com/in/alexanderbien/" 
      target="_blank" 
      rel="noopener noreferrer"
      aria-label="LinkedIn"
      class="flex flex-row items-center justify-center md:justify-start gap-0 md:gap-3 px-2 py-2 md:px-3 text-text-muted hover:text-accent transition-colors cursor-pointer"
    >
      <Linkedin class="w-5 h-5" />
      <span class="hidden md:inline text-[11px] font-mono">LinkedIn</span>
    </a>
  </div>
</aside>
