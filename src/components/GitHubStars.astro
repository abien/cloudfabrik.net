---
import { Star, ArrowRight } from '@lucide/astro';
import { scrapeGitHubStarsList } from '../utils/github';

interface Props {
  limit?: number;
}

const { limit = 10 } = Astro.props;

const repos = await scrapeGitHubStarsList(limit);
---

<section>
  <div class="flex items-center justify-between mb-4 border-b border-border pb-2">
    <h2 class="font-mono text-syntax-blue text-sm font-bold tracking-widest">[03] GITHUB_STARS</h2>
    <span class="text-[10px] text-text-muted font-mono">count: {repos.length}</span>
  </div>
  
  {repos.length > 0 ? (
    <div class="space-y-2">
      {repos.map((repo) => (
        <a 
          href={repo.url}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-bg-editor/50 border border-border rounded p-3 flex justify-between items-center group cursor-pointer hover:bg-bg-editor hover:border-syntax-blue/50 transition-all"
        >
          <div class="flex flex-col gap-1 flex-1">
            <span class="font-mono text-xs text-text-primary group-hover:text-syntax-blue transition-colors">
              {repo.nameWithOwner}
            </span>
            {repo.description && (
              <span class="font-mono text-[9px] text-text-muted line-clamp-1">
                {repo.description}
              </span>
            )}
          </div>
          <div class="flex items-center gap-2 ml-4 shrink-0">
            <span class="font-mono text-[10px] text-text-muted flex items-center gap-1">
              <Star class="w-3 h-3" />
              {repo.stargazerCount}
            </span>
            <ArrowRight class="w-4 h-4 text-text-muted group-hover:text-syntax-blue transition-colors" />
          </div>
        </a>
      ))}
    </div>
  ) : (
    <div class="bg-bg-editor/30 border border-border rounded p-4 text-center">
      <p class="font-mono text-xs text-text-muted">Failed to load GitHub stars</p>
    </div>
  )}
</section>
